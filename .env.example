# ==============================================================================
# AXIOM TRADE // PULSE & J7TRACKER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Twitter / X Live Tracker Service Key (TwexAPI.io)
# Ücretsiz 20,000 kredi ile canlı tweet akışı sağlar. Çoklu key için virgülle ayırabilirsiniz.
TWEXAPI_KEY=your_twexapi_key_here

# Solana Ağ Tercihi (devnet veya mainnet-beta)
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Solana RPC Endpoint'leri
NEXT_PUBLIC_DEVNET_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_MAINNET_RPC=https://api.mainnet-beta.solana.com

# Opsiyonel: Hızlı Özel RPC (Helius, QuickNode, Triton vb.). Boş bırakılırsa standart public kullanılır.
NEXT_PUBLIC_RPC_URL=
